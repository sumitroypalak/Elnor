<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+): nothing of Elnor is copied to Google cloud backup or to another phone
    by the system. The notes database and the settings stay on this phone only.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
