<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        allowBackup is off on purpose: otherwise the notes database would be copied to Google
        cloud backup / adb backup, where the App lock does not protect it. Elnor has its own
        backup file (Settings > Backup & restore) for moving notes between phones.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Elnor">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Touch and hold the icon: "New note" (see QuickNote.kt) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            The "New note" tile of the Quick Settings panel. The system binds to it, so it needs
            the BIND_QUICK_SETTINGS_TILE permission: only the system can use it.
        -->
        <service
            android:name=".NewNoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_new_note"
            android:label="@string/tile_new_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Text from other apps becomes a new note, with no screen of its own: "Share" > Elnor,
            and "Save to Elnor" in the menu that appears when text is selected. It has its own
            task and is kept out of Recent Apps, so it never disturbs the notes the user has open.
        -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Elnor.Transparent">
            <intent-filter android:label="Elnor">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Save to Elnor">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
